{
  "name": "virtual-asset-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "npm run rebuild:native:electron && npm run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:electron && tsc -b && tsc -p tsconfig.electron.json --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "index:prompt-library": "node scripts/index-prompt-library.mjs",
    "start": "npm run rebuild:native:electron && electron .",
    "package:mac": "npm run rebuild:native:electron && npm run build && node scripts/package-mac.mjs && node scripts/verify-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:mac": "npm test && npm run package:mac && codesign --verify --deep --strict --verbose=2 'release/虚拟资产创作工作台-darwin-arm64/虚拟资产创作工作台.app'",
    "test": "npm run rebuild:native:node && vitest run",
    "test:watch": "vitest",
    "rebuild:native:electron": "npm rebuild better-sqlite3 --runtime=electron --target=38.8.6 --dist-url=https://electronjs.org/headers",
    "rebuild:native:node": "npm rebuild better-sqlite3 --runtime=node --target=22.23.1"
  },
  "dependencies": {
    "@img/sharp-libvips-darwin-arm64": "^1.3.3",
    "better-sqlite3": "^12.4.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@electron/packager": "^20.3.0",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.341",
    "@phosphor-icons/react": "^2.1.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "antd": "^5.29.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
